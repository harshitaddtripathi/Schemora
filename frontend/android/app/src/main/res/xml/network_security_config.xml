<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml
  Allows cleartext HTTP to 10.0.2.2 (Android emulator host alias), 127.0.0.1, and localhost.
  All other traffic (e.g. production Render URL) requires HTTPS.
-->
<network-security-config>
    <!-- Local development: Android emulator (10.0.2.2), ADB reverse (127.0.0.1 / localhost), and Wi-Fi LAN -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Allow cleartext HTTP for local development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
