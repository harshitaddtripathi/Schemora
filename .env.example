# Phase 0 infrastructure placeholders only.
# Do not place real credentials in this file.

APP_ENV=phase0

# Firebase Authentication
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-client-email
FIREBASE_PRIVATE_KEY=replace-with-firebase-private-key

# Supabase PostgreSQL and pgvector
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_DATABASE_URL=postgresql://replace-with-database-url
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Supabase Storage
SUPABASE_USER_DOCUMENTS_BUCKET=user-documents
SUPABASE_KNOWLEDGE_SOURCES_BUCKET=knowledge-source-files

# Gemini API
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_GENERATION_MODEL=replace-with-approved-generation-model
GEMINI_EMBEDDING_MODEL=replace-with-approved-embedding-model

# Render backend placeholder
RENDER_SERVICE_NAME=schemora-api
RENDER_EXTERNAL_URL=https://replace-with-render-service.onrender.com
