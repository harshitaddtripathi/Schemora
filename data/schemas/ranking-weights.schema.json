{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemora.local/schemas/ranking-weights.schema.json",
  "title": "Schemora Ranking Weights",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "eligibility_gate_required",
    "components",
    "total",
    "notes"
  ],
  "properties": {
    "model_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "eligibility_gate_required": {
      "const": true
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "education_relevance",
        "benefit_relevance",
        "document_readiness",
        "deadline_priority",
        "advisory_rule_match"
      ],
      "properties": {
        "education_relevance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "benefit_relevance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "document_readiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "deadline_priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "advisory_rule_match": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "total": {
      "const": 100
    },
    "notes": {
      "$ref": "https://schemora.local/schemas/common.schema.json#/$defs/nonEmptyString"
    }
  }
}
