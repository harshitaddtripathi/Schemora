{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemora.local/schemas/expected-result.schema.json",
  "title": "Schemora Benchmark Expected Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version",
    "results"
  ],
  "properties": {
    "dataset_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "scheme_id",
        "expected_status",
        "passed_rule_ids",
        "failed_rule_ids",
        "unresolved_rule_ids",
        "expected_document_ids",
        "supporting_source_ids",
        "notes"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^profile-[0-9]{3}$"
        },
        "scheme_id": {
          "type": "string",
          "pattern": "^sch-[a-z0-9-]+$"
        },
        "expected_status": {
          "$ref": "https://schemora.local/schemas/common.schema.json#/$defs/eligibilityStatus"
        },
        "passed_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "failed_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "unresolved_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "expected_document_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "supporting_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^src-[a-z0-9-]+$"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
